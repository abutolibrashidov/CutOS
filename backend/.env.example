# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Barber Platform"
ENVIRONMENT=development
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber
POSTGRES_DB=barber_db
# Dedicated database used only by pytest. It must never be the development DB.
TEST_POSTGRES_DB=barber_test_db

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Random secret for webhook verification (generate a long random string)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
# Telegram Mini App initData validity window and tolerated future clock skew.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
